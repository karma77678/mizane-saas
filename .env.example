# ---------------------------------------------------------------------------
# Mizan — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real password, connection string or API key.
#
# Syntax warning: a value ends at the end of the line, and a `#` only starts a
# comment when preceded by whitespace. Writing
#   DATABASE_URL=postgresql://...postgres# some comment
# makes "# some comment" part of the connection string, and the failure that
# follows is very hard to read. Keep comments on their own line.
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL / Supabase connection string.
# Supabase: Project settings -> Database -> Connection string -> URI.
# Prefer the pooler host (port 6543) for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# ---------------------------------------------------------------------------
# Optional database tuning. Defaults shown; values are milliseconds.
# ---------------------------------------------------------------------------
# Caps how long a request waits for a connection. Without it, a network that
# silently drops the PostgreSQL port makes requests hang forever instead of
# reporting an error.
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=60000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_MAX=8

# TLS mode: auto (default) | require | verify-full | disable.
# `auto` turns TLS off only for local hosts and keeps verification on for every
# remote host. Never disable certificate verification against a managed database.
# DATABASE_SSL=auto
# Extra CA bundle, needed for a direct db.<ref>.supabase.co connection.
# It is added alongside the system trust store, never instead of it.
# DATABASE_CA_CERT_PATH=./prod-ca-2021.crt

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Port the Express API listens on. Railway and AWS usually inject this.
PORT=8080
# NODE_ENV=production enables Secure session cookies and JSON logs.
# NODE_ENV=production
# REQUEST_TIMEOUT_MS=120000
# JSON_BODY_LIMIT=50mb
# LOG_LEVEL=info

# Set only when the UI is served from a different origin than the API.
# Leave empty for same-origin deployments.
APP_ORIGIN=

# Set to serve the built UI from the API process (single-container deploys),
# relative to the API working directory. Leave empty to stay API-only.
# SERVE_STATIC_DIR=../audit-maroc/dist/public

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------
# Enables AI correction drafts and the aggregated review; uses the Groq free plan or this key's billing (console.groq.com).
# Leave blank to run Mizan with no AI call at all.
GROQ_API_KEY=
# Optional: override the Groq model (default openai/gpt-oss-120b).
GROQ_MODEL=
# Optional: Groq plan shown on the "Consommation IA" page (free | paid; default free) and the daily
# limits its gauges use (defaults: 200000 tokens and 1000 requests, Groq free plan for gpt-oss-120b).
GROQ_PLAN=
GROQ_DAILY_TOKEN_LIMIT=
GROQ_DAILY_REQUEST_LIMIT=

# Only this exact e-mail receives the global admin role at registration.
# Cabinet membership roles stay scoped to each workspace.
MIZAN_BOOTSTRAP_ADMIN_EMAIL=admin@your-cabinet.example
