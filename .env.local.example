# ---------------------------------------------------------------------------
# Local development only. Copy to `.env.local`.
#
# `.env.local` is read before `.env` and never overrides a variable already
# exported in the shell. Keep real credentials out of both files in git.
#
# Keep comments on their own line: `URL=...postgres# note` puts "# note"
# inside the connection string.
# ---------------------------------------------------------------------------

# Local Docker database from docker-compose.local.yml. Test-only credentials.
DATABASE_URL=postgresql://mizan:mizan_dev_only@127.0.0.1:5432/mizan

# To test against Supabase instead, use your own pooler URI (port 6543) and
# keep it out of version control:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Local Docker PostgreSQL has no TLS; `auto` already detects 127.0.0.1.
# DATABASE_SSL=auto

PORT=8080

# Optional. Leave blank to run without any AI call.
GROQ_API_KEY=
# Optional: override the Groq model (default openai/gpt-oss-120b).
GROQ_MODEL=
# Optional: Groq plan shown on the "Consommation IA" page (free | paid; default free) and the daily
# limits its gauges use (defaults: 200000 tokens and 1000 requests, Groq free plan for gpt-oss-120b).
GROQ_PLAN=
GROQ_DAILY_TOKEN_LIMIT=
GROQ_DAILY_REQUEST_LIMIT=

# This exact e-mail is assigned the global admin role on registration.
MIZAN_BOOTSTRAP_ADMIN_EMAIL=admin@mizan.local
